[Unit]
Description=EchoEar LAN voice and OTA bridge
Wants=network-online.target hex.service echoear-opencode.service
After=network-online.target hex.service echoear-opencode.service

[Service]
EnvironmentFile=@ENV_FILE@
Environment="XDG_DATA_HOME=@DATA_HOME@"
Environment="ECHOEAR_REPO_DIR=@REPO_DIR@"
ExecStart="@BRIDGE_BIN@"
Restart=on-failure
KillMode=mixed
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
