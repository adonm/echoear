[Unit]
Description=EchoEar LAN voice and OTA bridge
Wants=network-online.target hex.service
After=network-online.target hex.service

[Service]
EnvironmentFile=%E/echoear/bridge.env
ExecStart=/usr/bin/python3 "@REPO_DIR@/bridge/server.py"
Restart=on-failure
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
