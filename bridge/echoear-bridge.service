[Unit]
Description=EchoEar LAN voice and OTA bridge
Wants=network-online.target hex.service
After=network-online.target hex.service

[Service]
EnvironmentFile=%E/echoear/bridge.env
Environment="XDG_DATA_HOME=@DATA_HOME@"
Environment="ECHOEAR_TTS_PYTHON=@TTS_PYTHON@"
Environment="ECHOEAR_TTS_WORKER=@REPO_DIR@/bridge/tts_worker.py"
ExecStart="@BRIDGE_BIN@"
Restart=on-failure
KillMode=mixed
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
